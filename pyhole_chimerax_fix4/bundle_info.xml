<?xml version="1.0" encoding="UTF-8"?>
<BundleInfo name="ChimeraX-pyHole"
            version="1.1"
            package="chimerax.pyhole"
            minSessionVersion="1"
            maxSessionVersion="1">

  <Author>pyHole authors</Author>
  <Email>pyhole@example.org</Email>
  <URL>https://example.org/pyhole</URL>

  <Synopsis>pyHole: pore geometry and energetics</Synopsis>
  <Description>
    Compute pore-radius profiles (straight/curved centerlines), conductance proxy,
    hydrophobicity/electrostatics indices, passability; export CSV, centerline and mesh PDB.
  </Description>

  <Categories>
    <Category name="Structure Analysis"/>
  </Categories>

  <Dependencies>
    <Dependency name="ChimeraX-Core" version="~=1.1"/>
    <Dependency name="ChimeraX-UI"   version="~=1.0"/>
    <!-- holepy.py builds a KD-tree (scipy.spatial.cKDTree) for pore-clearance
         search instead of scanning every atom per query point. -->
    <Dependency name="scipy" version=">=1.7"/>
    <!-- gemmi is used to transparently convert mmCIF (or any other gemmi-readable
         format) to legacy PDB before parsing; see ensure_legacy_pdb() in holepy.py. -->
    <Dependency name="gemmi" version=">=0.6.5"/>
    <!-- mrcfile writes the true-surface density map (non-crystallographic MRC,
         MRC2014 ORIGIN convention) for isosurfacing the pore lumen in ChimeraX. -->
    <Dependency name="mrcfile" version=">=1.3"/>
  </Dependencies>

  <Classifiers>
    <!-- EXACTLY 5 fields: Tool :: name :: category :: description -->
    <ChimeraXClassifier>
      ChimeraX :: Tool :: pyHole :: Structure Analysis :: Pore geometry and energetics
    </ChimeraXClassifier>
  </Classifiers>

</BundleInfo>
